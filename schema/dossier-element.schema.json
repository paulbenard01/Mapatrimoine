{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "In-depth research file for one UNESCO inscription (front matter of content/elements/<key>.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "status",
    "decision",
    "unesco_file",
    "states",
    "extensions",
    "domains",
    "territories",
    "communities",
    "bodies",
    "summary_30s",
    "key_facts",
    "conversation",
    "sources",
    "last_checked"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,60}$"
    },
    "status": {
      "enum": [
        "inscribed",
        "nominated"
      ]
    },
    "title_fr": {
      "type": "string",
      "minLength": 3
    },
    "title_en": {
      "type": "string",
      "minLength": 3
    },
    "list": {
      "enum": [
        "RL",
        "USL",
        "GSP"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 2008,
      "maximum": 2100
    },
    "unesco_url": {
      "type": "string",
      "pattern": "^https://ich\\.unesco\\.org/"
    },
    "decision": {
      "type": "string",
      "minLength": 3
    },
    "unesco_file": {
      "type": "string",
      "minLength": 3
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "oral",
          "performing-arts",
          "social-practices",
          "nature-knowledge",
          "craftsmanship"
        ]
      }
    },
    "territories": {
      "type": "string",
      "minLength": 10
    },
    "communities": {
      "type": "string",
      "minLength": 10
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}_67717_INV_PCI_FRANCE_\\d{5}$"
      }
    },
    "summary_30s": {
      "type": "string",
      "minLength": 80,
      "maxLength": 1200
    },
    "key_facts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary",
        "mistakes",
        "sensitive",
        "questions"
      ],
      "properties": {
        "vocabulary": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "note"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 2
              },
              "note": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "mistakes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "sensitive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "association",
            "local_authority",
            "researcher",
            "institution"
          ],
          "properties": {
            "association": {
              "$ref": "#/$defs/five_questions"
            },
            "local_authority": {
              "$ref": "#/$defs/five_questions"
            },
            "researcher": {
              "$ref": "#/$defs/five_questions"
            },
            "institution": {
              "$ref": "#/$defs/five_questions"
            }
          }
        }
      }
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "last_checked": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "research_status": {
      "enum": [
        "in-progress",
        "drafted",
        "verified"
      ]
    }
  },
  "$defs": {
    "five_questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "\\?\\s*$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "consulted",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{1,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "consulted": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "unesco",
              "ministere",
              "porteur",
              "recherche",
              "presse",
              "autre"
            ]
          }
        }
      }
    }
  }
}
