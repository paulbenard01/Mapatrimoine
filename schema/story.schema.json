{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulbenard01/Mapatrimoine/schema/story.schema.json",
  "title": "PCI Map story (guided tour)",
  "description": "data/stories/<id>.yaml: a guided tour across several inventory elements that share a guiding idea (kind: theme) or a place (kind: place). Own words; drafts until Paul reviews them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "tagline",
    "intro",
    "steps",
    "outro",
    "lang_review",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,40}$"
    },
    "kind": {
      "enum": [
        "theme",
        "place"
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fr",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 5,
          "maxLength": 90
        },
        "en": {
          "type": "string",
          "minLength": 5,
          "maxLength": 90
        }
      }
    },
    "tagline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fr",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 20,
          "maxLength": 180
        },
        "en": {
          "type": "string",
          "minLength": 20,
          "maxLength": 180
        }
      }
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fr",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 200,
          "maxLength": 1000
        },
        "en": {
          "type": "string",
          "minLength": 200,
          "maxLength": 1000
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element",
          "heading",
          "text"
        ],
        "properties": {
          "element": {
            "type": "string",
            "pattern": "^\\d{4}_\\d+_INV_PCI_FRANCE_\\d{5}$"
          },
          "heading": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fr",
              "en"
            ],
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 5,
                "maxLength": 90
              },
              "en": {
                "type": "string",
                "minLength": 5,
                "maxLength": 90
              }
            }
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fr",
              "en"
            ],
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 200,
                "maxLength": 1000
              },
              "en": {
                "type": "string",
                "minLength": 200,
                "maxLength": 1000
              }
            }
          },
          "look_for": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fr",
              "en"
            ],
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 20,
                "maxLength": 260
              },
              "en": {
                "type": "string",
                "minLength": 20,
                "maxLength": 260
              }
            },
            "description": "What to look or listen for."
          }
        }
      }
    },
    "outro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fr",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 150,
          "maxLength": 800
        },
        "en": {
          "type": "string",
          "minLength": 150,
          "maxLength": 800
        }
      }
    },
    "lang_review": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "reviewed"
      ]
    }
  }
}
