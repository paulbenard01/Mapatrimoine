{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulbenard01/Mapatrimoine/schema/mediation.schema.json",
  "title": "PCI Map mediation sheet",
  "description": "Content of the printable bilingual mediation sheet of one inventory element (data/mediation/<id>.yaml). Written for this site; drafts until Paul reviews them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "audience", "questions", "vocabulary", "lang_review", "review_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{4}_\\d+_INV_PCI_FRANCE_\\d{5}$"},
    "audience": {
      "description": "Who the questions are pitched at.",
      "enum": ["general", "school", "family"]
    },
    "questions": {
      "description": "Three open discussion questions, the same three in each language.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fr", "en"],
      "properties": {
        "fr": {"$ref": "#/$defs/three"},
        "en": {"$ref": "#/$defs/three"}
      }
    },
    "vocabulary": {
      "description": "Five terms needed to talk about the element, each defined in both languages.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fr", "en", "def_fr", "def_en"],
        "properties": {
          "fr": {"type": "string", "minLength": 2, "maxLength": 60},
          "en": {"type": "string", "minLength": 2, "maxLength": 60},
          "def_fr": {"type": "string", "minLength": 10, "maxLength": 240},
          "def_en": {"type": "string", "minLength": 10, "maxLength": 240}
        }
      }
    },
    "lang_review": {"enum": ["draft", "reviewed"]},
    "review_status": {"enum": ["unreviewed", "reviewed"]}
  },
  "$defs": {
    "three": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 15, "maxLength": 240, "pattern": "\\?$"}
    }
  }
}
