{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thematic research dossier (front matter of content/dossiers/<NN>-<slug>.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "title",
    "elements",
    "sources",
    "last_checked"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "elements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "consulted",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{1,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "consulted": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "unesco",
              "ministere",
              "porteur",
              "recherche",
              "presse",
              "autre"
            ]
          }
        }
      }
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "research_status": {
      "enum": [
        "in-progress",
        "drafted",
        "verified"
      ]
    }
  }
}
